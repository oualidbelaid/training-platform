# Copy to .env for local development. Never commit the real .env file.

# Base URL for the app's own API layer (proxies external calls where needed).
VITE_API_URL=http://localhost:5173/api

# Dolibarr ERP REST API base URL. Not used while VITE_USE_MOCK=true.
# NOTE: any real Dolibarr API token must NOT be stored in a VITE_-prefixed
# variable — those are compiled into the public client bundle. A write-capable
# token requires a backend/BFF proxy (see docs/DOLIBARR_GUIDE.md).
VITE_DOLIBARR_URL=

# development | staging | production
VITE_APP_ENV=development

# When true, all repositories resolve to their Mock implementation.
VITE_USE_MOCK=true

# Production origin for canonical URLs, hreflang, Open Graph and the sitemap
# (no trailing slash). Falls back to a placeholder until a real domain is
# assigned — see docs/SEO_GUIDE.md.
VITE_SITE_URL=
